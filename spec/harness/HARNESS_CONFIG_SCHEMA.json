{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/robkazi52/upgradeables/spec/harness/HARNESS_CONFIG_SCHEMA.json",
  "title": "Upgradeables Harness Config",
  "type": "object",
  "required": ["schema_version", "profile_mode", "install_depth", "preferred_profiles", "agent_integrations", "record_task_events", "skill_suggestion_threshold", "reference_roots", "network"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "profile_mode": {"enum": ["auto", "fixed"]},
    "install_depth": {"enum": ["minimal", "standard", "full"]},
    "preferred_profiles": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "agent_integrations": {"type": "array", "items": {"enum": ["generic", "codex", "claude", "copilot"]}, "uniqueItems": true},
    "record_task_events": {"type": "boolean"},
    "skill_suggestion_threshold": {"type": "integer", "minimum": 2},
    "reference_roots": {"type": "array", "items": {"type": "string", "pattern": "^[^/\\\\].*|^[A-Za-z0-9_.-]+/$"}, "uniqueItems": true},
    "network": {
      "type": "object",
      "required": ["allow_registry_update"],
      "properties": {"allow_registry_update": {"type": "boolean"}},
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
