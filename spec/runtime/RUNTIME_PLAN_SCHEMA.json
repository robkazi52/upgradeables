{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/robkazi52/upgradeables/spec/runtime/RUNTIME_PLAN_SCHEMA.json",
  "title": "Upgradeables provider-neutral runtime plan",
  "type": "object",
  "required": ["schema_version", "compiler_version", "task_resolution_hash", "model_profile", "host", "base_instructions_present", "task", "failure_modes", "complexity", "instruction_capsule", "state_contract", "validators", "orchestration", "tool_requirements", "output_contract", "components", "excluded_runtime_components", "warnings", "token_estimate", "token_estimate_approximate", "decisions", "directive_provenance", "manifest_hash"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "compiler_version": {"type": "string"},
    "task_resolution_hash": {"pattern": "^sha256:[0-9a-f]{64}$"},
    "model_profile": {"enum": ["small", "medium", "strong", "auto", "custom"]},
    "host": {"type": "object"},
    "base_instructions_present": {"type": "boolean"},
    "task": {"type": "object"},
    "failure_modes": {"type": "array"},
    "complexity": {"type": "object"},
    "instruction_capsule": {"type": "string"},
    "state_contract": {"type": "array"},
    "validators": {"type": "array"},
    "orchestration": {"type": "array"},
    "tool_requirements": {"type": "array"},
    "output_contract": {"type": "array"},
    "components": {"type": "array"},
    "excluded_runtime_components": {"type": "array"},
    "warnings": {"type": "array", "items": {"type": "string"}},
    "token_estimate": {"type": "integer", "minimum": 0},
    "token_estimate_approximate": {"const": true},
    "decisions": {"type": "array"},
    "directive_provenance": {"type": "array"},
    "manifest_hash": {"pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
