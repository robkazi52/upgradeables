{
  "schema_version": "1.0.0",
  "cases": [
    {
      "package": "placeholder-suppression",
      "check": "no_unresolved_placeholders",
      "input": {"text": "Hello Robbie; project status is ready."},
      "expected": true
    },
    {
      "package": "stateblock",
      "check": "required_stateblock_fields",
      "input": {"state": {"task": "audit", "phase": "validate", "constraints": ["source bounded"], "decisions": [], "open_items": []}},
      "expected": true
    },
    {
      "package": "state-snapshot",
      "check": "required_snapshot_fields",
      "input": {"snapshot": {"version": "1", "task": "audit", "phase": "validate", "locked_facts": [], "next_action": "run checks"}},
      "expected": true
    },
    {
      "package": "safe-rewrite",
      "check": "locked_literals_preserved",
      "input": {"before": "Limit: 15 mg; ID A-17.", "after": "The limit is 15 mg under ID A-17.", "locked": ["15 mg", "A-17"]},
      "expected": true
    },
    {
      "package": "citation-fidelity",
      "check": "exact_quote_exists",
      "input": {"source": "The measured reduction was 12 percent in the study group.", "quote": "reduction was 12 percent"},
      "expected": true
    },
    {
      "package": "task-set-lock-in",
      "check": "task_lock_complete",
      "input": {"lock": {"objective": "publish audit", "deliverable": "release", "constraints": ["all checks pass"], "done_when": ["public URL resolves"]}},
      "expected": true
    }
  ]
}
