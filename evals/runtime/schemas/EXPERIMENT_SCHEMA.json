{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "experiment_id", "suite", "conditions", "model", "trials_per_task", "temperature", "seed_policy", "grader"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "experiment_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "suite": {"type": "string", "minLength": 1},
    "conditions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["baseline", "static-full", "adaptive-runtime"]}},
    "model": {
      "type": "object",
      "required": ["adapter", "model"],
      "properties": {
        "adapter": {"type": "string", "minLength": 1},
        "model": {"type": "string", "minLength": 1}
      }
    },
    "trials_per_task": {"type": "integer", "minimum": 1},
    "temperature": {"type": "number"},
    "seed_policy": {"type": "string", "minLength": 1},
    "grader": {"const": "objective"},
    "order_seed": {"type": "integer"}
  },
  "additionalProperties": true
}
