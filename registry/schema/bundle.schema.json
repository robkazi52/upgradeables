{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Bundle metadata",
  "type": "object",
  "required": [
    "schema_version",
    "slug",
    "display_name",
    "version",
    "purpose",
    "components",
    "load_order"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "display_name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "load_order": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    }
  }
}
