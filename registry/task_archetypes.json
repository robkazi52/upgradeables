    },
    {
      "slug": "fixed-workflow",
      "description": "A predefined sequence with known checks and exits."
    },
    {
      "slug": "tool-assisted",
      "description": "Read, calculate, inspect, or validate through one or more tools while preserving the primary task."
    },
    {
      "slug": "stateful-continuation",
      "description": "Work persists explicit state across context windows, sessions, approvals, or external waits."
    },
    {
      "slug": "agentic-loop",
