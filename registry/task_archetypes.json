  "selection_prior_disclaimer": "This registry supplies deterministic discovery priors. It is not an activation table and does not claim that an Upgradeable empirically improves a task. Explicit task wording, permissions, recipe roles, triggers, non-triggers, dependencies, conflicts, counterbalances, and the complexity ceiling still govern selection.",
  "axis_model": {
    "primary_archetype": "The user's main requested outcome. Prefer one.",
    "domain": "The subject or project context. A domain adjusts priors but does not replace the primary goal.",
    "subtype": "A narrower task intent within the primary archetype.",
    "execution_form": "How work proceeds: direct, workflow, tool-assisted, stateful, agentic, or orchestrated.",
    "environment_modifiers": "Explicit facts about sources, tools, permissions, persistence, risk, fidelity, and output constraints.",
    "failure_modes": "Observable risks that promote or demote controls.",
    "complexity": "The L0-L5 floor and ceiling applied before expensive controls or orchestration are considered."
  },
  "domains": [
    "general",
    "software-development",
    "research-and-knowledge",
    "documentation",
    "data-analysis",
    "medical-evidence",
    "legal-evidence",
